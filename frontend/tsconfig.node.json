{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["vite.config.ts", "eslint.config.ts", "scripts/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "allowJs": true
  }
}

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
DEMO_USERS={"aisyah":{"name":"Aisyah (HR)","groups":["all","hr"]},"ben":{"name":"Ben (Staff)","groups":["all"]}}
ORG_NAME=Serimaju Technologies
AI_PROVIDER=ilmu
AI_BASE_URL=https://api.ilmu.ai/v1
AI_API_KEY=

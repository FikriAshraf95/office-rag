# Hash: python -m app.security.passwords · secret: python -m app.security.passwords --secret
LOGIN_USERS={}
SESSION_SECRET=
SESSION_DAYS=7
TUNNEL_TOKEN=
CHAT_RATE_PER_MIN=6
CHAT_DAILY_CAP=100
PAYG_ALERT_MYR=5
